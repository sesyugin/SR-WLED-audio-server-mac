<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Права для подписи с hardened runtime.

    Hardened runtime включается только при подписи настоящим сертификатом
    (SRWLED_SIGN_IDENTITY) и обязателен для нотаризации. Без этого файла он
    отбирает у программы доступ к звуку: диалог разрешения показывается,
    человек его выдаёт, а захват всё равно возвращает одни нули — и понять,
    почему, по интерфейсу невозможно.

    Песочницы здесь нет намеренно: приложение шлёт UDP на произвольные адреса
    домашней сети, а песочница потребовала бы отдельного права и на это,
    и на исходящие соединения, ничего не добавив к безопасности.
-->
<plist version="1.0">
<dict>
    <!-- Чтение системного звука через CoreAudio process tap. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
